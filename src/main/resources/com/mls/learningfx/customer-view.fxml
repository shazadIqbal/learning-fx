<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Outer Full-Screen Background (#0b1326) -->
<StackPane style="-fx-background-color: #0b1326;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mls.learningfx.controller.CustomerViewController">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
    </padding>
    <children>
        <!-- Centered Main Application Card -->
        <VBox maxHeight="760.0" maxWidth="920.0" spacing="20.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.45), 30, 0, 0, 12);">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
            </padding>
            <children>
                <!-- Top Navigation Bar -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button fx:id="backButton" mnemonicParsing="false" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 14;" text="← Back to Dashboard" />
                        <Region HBox.hgrow="ALWAYS" />
                        <VBox alignment="CENTER_RIGHT">
                            <children>
                                <Label text="REGISTRY VIEW" textFill="#94a3b8">
                                    <font>
                                        <Font name="System Bold" size="10.0" />
                                    </font>
                                </Label>
                                <Label text="Customer Management" textFill="#475569">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Page Heading -->
                <VBox spacing="3.0">
                    <children>
                        <Label text="Customer Management" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="26.0" />
                            </font>
                        </Label>
                        <Label text="Directory lookup, contact records, and purchase history routing." textFill="#64748b">
                            <font>
                                <Font size="13.5" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Search Bar Container -->
                <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 10;">
                    <children>
                        <TextField fx:id="searchField" prefHeight="40.0" promptText="Search customer by name or contact..." style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13.5px;" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleSearch" prefHeight="40.0" prefWidth="105.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Search" />
                        <Button mnemonicParsing="false" onAction="#handleShowAll" prefHeight="40.0" prefWidth="105.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Show All" />
                    </children>
                </HBox>

                <!-- Section Header + Add Customer Button -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Customer Records" textFill="#1e293b">
                            <font>
                                <Font name="System Bold" size="17.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#addCustomer" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="+ Add Customer" />
                    </children>
                </HBox>

                <!-- Customer TableView -->
                <TableView fx:id="tableView" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-background-radius: 10;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" maxWidth="110.0" minWidth="75.0" prefWidth="85.0" text="ID" />
                        <TableColumn fx:id="nameColumn" minWidth="180.0" prefWidth="240.0" text="Customer Name" />
                        <TableColumn fx:id="contactColumn" minWidth="150.0" prefWidth="200.0" text="Contact" />
                        <TableColumn fx:id="actionColumn" maxWidth="280.0" minWidth="210.0" prefWidth="240.0" text="Actions" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Footer Meta Bar -->
                <VBox spacing="8.0">
                    <children>
                        <Separator />
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="● Ready • Customer Directory Synced" textFill="#64748b">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="Press Enter in search box to filter" textFill="#94a3b8">
                                    <font>
                                        <Font size="11.5" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>