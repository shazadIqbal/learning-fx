<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="660.0" prefWidth="900.0" style="-fx-background-color: #f3f6fb;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mls.learningfx.controller.DashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: white;">
            <padding><Insets bottom="22.0" left="34.0" right="34.0" top="22.0" /></padding>
            <children>
                <ImageView fitHeight="42.0" fitWidth="48.0" preserveRatio="true">
                    <image><Image url="@icon/box.png" /></image>
                </ImageView>
                <VBox spacing="4.0">
                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="POS" />
                    <Label style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #172033;" text="Welcome back" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Choose a workspace" />
            </children>
        </HBox>
    </top>
    <center>
        <GridPane alignment="CENTER" hgap="20.0" vgap="20.0">
            <padding><Insets bottom="40.0" left="44.0" right="44.0" top="34.0" /></padding>
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="190.0" percentWidth="33.33" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="190.0" percentWidth="33.33" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="190.0" percentWidth="33.34" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="170.0" percentHeight="50.0" vgrow="ALWAYS" />
                <RowConstraints minHeight="170.0" percentHeight="50.0" vgrow="ALWAYS" />
            </rowConstraints>
            <children>
                <Button fx:id="productBtn" contentDisplay="TOP" graphicTextGap="16.0" maxHeight="Infinity" maxWidth="Infinity" onAction="#productView" style="-fx-background-color: white; -fx-border-color: #dce4ef; -fx-border-radius: 14px; -fx-background-radius: 14px; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #24324a; -fx-cursor: hand;" text="Products">
                    <graphic><ImageView fitHeight="48.0" fitWidth="52.0" preserveRatio="true"><image><Image url="@icon/box.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="supplierBtn" contentDisplay="TOP" graphicTextGap="16.0" maxHeight="Infinity" maxWidth="Infinity" onAction="#supplierView" style="-fx-background-color: white; -fx-border-color: #dce4ef; -fx-border-radius: 14px; -fx-background-radius: 14px; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #24324a; -fx-cursor: hand;" text="Suppliers" GridPane.columnIndex="1">
                    <graphic><ImageView fitHeight="48.0" fitWidth="52.0" preserveRatio="true"><image><Image url="@icon/supplier.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="customerBtn" contentDisplay="TOP" graphicTextGap="16.0" maxHeight="Infinity" maxWidth="Infinity" onAction="#customerView" style="-fx-background-color: white; -fx-border-color: #dce4ef; -fx-border-radius: 14px; -fx-background-radius: 14px; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #24324a; -fx-cursor: hand;" text="Customers" GridPane.columnIndex="2">
                    <graphic><ImageView fitHeight="48.0" fitWidth="52.0" preserveRatio="true"><image><Image url="@icon/group.png" /></image></ImageView></graphic>
                </Button>
                <Button contentDisplay="TOP" graphicTextGap="16.0" maxHeight="Infinity" maxWidth="Infinity" onAction="#onSaleClick" style="-fx-background-color: white; -fx-border-color: #dce4ef; -fx-border-radius: 14px; -fx-background-radius: 14px; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #24324a; -fx-cursor: hand;" text="Sale" GridPane.rowIndex="1">
                    <graphic><ImageView fitHeight="48.0" fitWidth="52.0" preserveRatio="true"><image><Image url="@icon/sales.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="reportBtn" contentDisplay="TOP" graphicTextGap="16.0" maxHeight="Infinity" maxWidth="Infinity" onAction="#reportView" style="-fx-background-color: white; -fx-border-color: #dce4ef; -fx-border-radius: 14px; -fx-background-radius: 14px; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #24324a; -fx-cursor: hand;" text="Reports" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <graphic><ImageView fitHeight="48.0" fitWidth="52.0" preserveRatio="true"><image><Image url="@icon/report.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="logoutBtn" contentDisplay="TOP" graphicTextGap="16.0" maxHeight="Infinity" maxWidth="Infinity" onAction="#logout" style="-fx-background-color: white; -fx-border-color: #dce4ef; -fx-border-radius: 14px; -fx-background-radius: 14px; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #24324a; -fx-cursor: hand;" text="Sign Out" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <graphic><ImageView fitHeight="44.0" fitWidth="48.0" preserveRatio="true"><image><Image url="@icon/logout.png" /></image></ImageView></graphic>
                </Button>
            </children>
        </GridPane>
    </center>
</BorderPane>
