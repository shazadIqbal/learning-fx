<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1745.0" prefWidth="702.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mls.learningfx.controller.SaleViewController">

    <!-- TOP SECTION -->
    <top>
        <VBox spacing="15">

            <padding>
                <Insets bottom="15" left="25" right="25" top="20" />
            </padding>

            <Label style="-fx-font-size: 25px;                           -fx-font-weight: bold;" text="Create New Sale" />

            <HBox alignment="CENTER_LEFT" spacing="10">

                <TextField fx:id="searchField" prefHeight="42" promptText="Search product by name or barcode..." style="-fx-background-radius: 6;" HBox.hgrow="ALWAYS" />

                <Button fx:id="searchButton" onAction="#handleSearch" prefHeight="42" prefWidth="100" style="-fx-background-color: #2563eb;                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-background-radius: 6;" text="Search" />

            </HBox>
        </VBox>
    </top>


    <!-- CENTER SECTION -->
    <center>
        <VBox spacing="15">

            <padding>
                <Insets bottom="15" left="25" right="25" top="10" />
            </padding>

            <!-- AVAILABLE PRODUCTS -->
            <VBox spacing="10" VBox.vgrow="ALWAYS">

                <Label style="-fx-font-size: 17px;                               -fx-font-weight: bold;" text="Available Products" />

                <TableView fx:id="productTable" onMouseClicked="#handleProductClick" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="productIdColumn" prefWidth="45" text="ID" />

                        <TableColumn fx:id="productNameColumn" prefWidth="277.0" text="Product Name" />

                        <TableColumn fx:id="productCategoryColumn" prefWidth="117.0" text="Category" />

                        <TableColumn fx:id="productPriceColumn" prefWidth="116.0" text="Price" />
                  <TableColumn fx:id="productStockColumn" prefWidth="75.0" text="Stock" />

                    </columns>

                </TableView>

                <Label style="-fx-text-fill: #64748b;                               -fx-font-size: 11px;" text="Double-click a product to add it to the sale." />

            </VBox>


            <Separator />


            <!-- SELECTED ITEMS -->
            <VBox spacing="10" VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT">

                    <Label style="-fx-font-size: 17px;                                   -fx-font-weight: bold;" text="Selected Items" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label text="Items: " />

                    <Label fx:id="itemCountLabel" style="-fx-font-weight: bold;" text="0" />

                </HBox>

                <TableView fx:id="selectedItemsTable" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="productColumn" prefWidth="160" text="Product" />

                        <TableColumn fx:id="quantityColumn" prefWidth="65" text="Qty" />

                        <TableColumn fx:id="priceColumn" prefWidth="100" text="Price" />

                        <TableColumn fx:id="subTotalColumn" prefWidth="110" text="Subtotal" />

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>


    <!-- BOTTOM SECTION -->
    <bottom>
        <VBox spacing="15">

            <padding>
                <Insets bottom="20" left="25" right="25" top="15" />
            </padding>

            <Separator />

            <!-- GRAND TOTAL -->
            <HBox alignment="CENTER_RIGHT" spacing="15">

                <Label style="-fx-font-size: 20px;                               -fx-font-weight: bold;" text="GRAND TOTAL" />

                <Label fx:id="grandTotalLabel" style="-fx-font-size: 26px;                               -fx-font-weight: bold;                               -fx-text-fill: #16a34a;" text="Rs. 0.00" />

            </HBox>


            <!-- ACTION BUTTONS -->
            <HBox alignment="CENTER_RIGHT" spacing="12">

                <Button fx:id="backButton" onAction="#handleBack" prefHeight="45" prefWidth="130" style="-fx-background-color: #64748b;                                -fx-text-fill: white;                                -fx-font-size: 14px;                                -fx-background-radius: 6;" text="Back" />

                <Button fx:id="checkoutButton" onAction="#handleCheckout" prefHeight="45" prefWidth="170" style="-fx-background-color: #16a34a;                                -fx-text-fill: white;                                -fx-font-size: 15px;                                -fx-font-weight: bold;                                -fx-background-radius: 6;" text="Checkout" />

            </HBox>

        </VBox>
    </bottom>

</BorderPane>
