<?xml version="1.0" encoding="UTF-8"?>



<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<BorderPane prefHeight="1745.0"
            prefWidth="702.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mls.learningfx.controller.SaleViewController"
            style="-fx-background-color: #f4f6f9;">

    <!-- TOP SECTION -->
    <top>
        <VBox spacing="15">

            <padding>
                <Insets top="20" right="25" bottom="15" left="25"/>
            </padding>

            <Label text="Create New Sale"
                   style="-fx-font-size: 25px;
                          -fx-font-weight: bold;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">

                <TextField fx:id="searchField"
                           promptText="Search product by name or barcode..."
                           HBox.hgrow="ALWAYS"
                           prefHeight="42"
                           style="-fx-background-radius: 6;"/>

                <Button text="Search"
                        fx:id="searchButton"
                        onAction="#handleSearch"
                        prefHeight="42"
                        prefWidth="100"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

            </HBox>
        </VBox>
    </top>


    <!-- CENTER SECTION -->
    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="10" right="25" bottom="15" left="25"/>
            </padding>

            <!-- AVAILABLE PRODUCTS -->
            <VBox spacing="10"
                  VBox.vgrow="ALWAYS">

                <Label text="Available Products"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;"/>

                <TableView fx:id="productTable"
                           VBox.vgrow="ALWAYS"
                           onMouseClicked="#handleProductClick">

                    <columns>

                        <TableColumn fx:id="productIdColumn"
                                     text="ID"
                                     prefWidth="45"/>

                        <TableColumn fx:id="productNameColumn"
                                     text="Product Name"
                                     prefWidth="160"/>

                        <TableColumn fx:id="barcodeColumn"
                                     text="Barcode"
                                     prefWidth="110"/>

                        <TableColumn fx:id="stockColumn"
                                     text="Stock"
                                     prefWidth="65"/>

                        <TableColumn fx:id="priceColumn"
                                     text="Price"
                                     prefWidth="100"/>

                    </columns>

                </TableView>

                <Label text="Double-click a product to add it to the sale."
                       style="-fx-text-fill: #64748b;
                              -fx-font-size: 11px;"/>

            </VBox>


            <Separator/>


            <!-- SELECTED ITEMS -->
            <VBox spacing="10"
                  VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT">

                    <Label text="Selected Items"
                           style="-fx-font-size: 17px;
                                  -fx-font-weight: bold;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Items: "/>

                    <Label fx:id="itemCountLabel"
                           text="0"
                           style="-fx-font-weight: bold;"/>

                </HBox>

                <TableView fx:id="selectedItemsTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="selectedProductColumn"
                                     text="Product"
                                     prefWidth="160"/>

                        <TableColumn fx:id="quantityColumn"
                                     text="Qty"
                                     prefWidth="65"/>

                        <TableColumn fx:id="unitPriceColumn"
                                     text="Price"
                                     prefWidth="100"/>

                        <TableColumn fx:id="subtotalColumn"
                                     text="Subtotal"
                                     prefWidth="110"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>


    <!-- BOTTOM SECTION -->
    <bottom>
        <VBox spacing="15">

            <padding>
                <Insets top="15" right="25" bottom="20" left="25"/>
            </padding>

            <Separator/>

            <!-- GRAND TOTAL -->
            <HBox alignment="CENTER_RIGHT"
                  spacing="15">

                <Label text="GRAND TOTAL"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;"/>

                <Label fx:id="grandTotalLabel"
                       text="Rs. 0.00"
                       style="-fx-font-size: 26px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #16a34a;"/>

            </HBox>


            <!-- ACTION BUTTONS -->
            <HBox spacing="12"
                  alignment="CENTER_RIGHT">

                <Button text="Back"
                        fx:id="backButton"
                        onAction="#handleBack"
                        prefWidth="130"
                        prefHeight="45"
                        style="-fx-background-color: #64748b;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-background-radius: 6;"/>

                <Button text="Checkout"
                        fx:id="checkoutButton"
                        onAction="#handleCheckout"
                        prefWidth="170"
                        prefHeight="45"
                        style="-fx-background-color: #16a34a;
                               -fx-text-fill: white;
                               -fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

            </HBox>

        </VBox>
    </bottom>

</BorderPane>
