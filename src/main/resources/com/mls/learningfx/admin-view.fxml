<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="800.0"
      spacing="10.0"
      style="-fx-background-color: #f4f6f9;"
      xmlns="http://javafx.com/javafx/11.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mls.learningfx.controller.AdminController">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
    </padding>

    <children>

        <!-- header: back, title, add button -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">

            <children>

                <Button fx:id="backButton"
                        text="BACK"
                        mnemonicParsing="false"
                        prefHeight="32.0"
                        prefWidth="80.0" />

                <Label text="Admin Panel - Users"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="addUserButton"
                        text="ADD USER"
                        mnemonicParsing="false"
                        prefHeight="32.0"
                        prefWidth="130.0" />

            </children>
        </HBox>

        <!-- user table -->
        <TableView fx:id="userTable" VBox.vgrow="ALWAYS">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

            <columns>

                <TableColumn fx:id="idColumn"
                             prefWidth="40.0"
                             text="ID" />

                <TableColumn fx:id="nameColumn"
                             prefWidth="130.0"
                             text="Name" />

                <TableColumn fx:id="contactColumn"
                             prefWidth="110.0"
                             text="Contact" />

                <TableColumn fx:id="emailColumn"
                             prefWidth="160.0"
                             text="Email" />

                <TableColumn fx:id="passwordColumn"
                             prefWidth="110.0"
                             text="Password" />

                <TableColumn fx:id="roleColumn"
                             prefWidth="100.0"
                             text="Role" />

                <TableColumn fx:id="actionColumn"
                             minWidth="120.0"
                             prefWidth="120.0"
                             text="Actions" />

            </columns>

        </TableView>

    </children>

</VBox>
