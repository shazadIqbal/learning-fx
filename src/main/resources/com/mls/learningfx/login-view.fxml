<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="400.0" prefWidth="600.0" styleClass="root"
           stylesheets="@login.css"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mls.learningfx.controller.LoginController">
    <children>
        <VBox alignment="CENTER" maxWidth="340.0" maxHeight="-Infinity" spacing="14.0" styleClass="card">
            <children>
                <Label styleClass="title" text="Welcome To POS" />
                <Label styleClass="subtitle" text="Please login to continue" />

                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="field-label" text="Username" />
                        <TextField fx:id="username" promptText="Enter username" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="field-label" text="Password" />
                        <PasswordField fx:id="password" promptText="Enter password" />
                    </children>
                </VBox>

                <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity"
                        onAction="#sayLogin" styleClass="login-button" text="Login" />

                <Label fx:id="errorLabel" maxWidth="Infinity" styleClass="error-label" wrapText="true" />
            </children>
        </VBox>
    </children>
</StackPane>