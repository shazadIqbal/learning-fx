<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane prefHeight="445.0" prefWidth="602.0"
            xmlns="http://javafx.com/javafx/11.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mls.learningfx.controller.ProductViewController">

    <children>

        <HBox alignment="CENTER_LEFT"
              layoutX="14.0"
              layoutY="21.0"
              prefHeight="52.0"
              prefWidth="574.0"
              spacing="10.0">

            <children>

                <Button fx:id="backButton"
                        text="BACK"
                        mnemonicParsing="false"
                        prefWidth="65.0" />

                <Button fx:id="addProductButton"
                        text="ADD PRODUCT"
                        mnemonicParsing="false"
                        prefWidth="145.0" />

                <Region HBox.hgrow="ALWAYS" />

                <TextField fx:id="searchField"
                           promptText="Search products..."
                           prefWidth="175.0" />

            </children>
        </HBox>

        <TextField fx:id="barcodeField"
                   layoutX="24.0"
                   layoutY="80.0"
                   prefWidth="210.0"
                   prefHeight="28.0"
                   promptText="Enter or scan barcode..." />

        <TableView fx:id="productTable"
                   layoutX="4.0"
                   layoutY="126.0"
                   prefHeight="310.0"
                   prefWidth="593.0">

            <columns>

                <TableColumn fx:id="idColumn"
                             prefWidth="38.0"
                             text="ID" />

                <TableColumn fx:id="nameColumn"
                             prefWidth="115.0"
                             text="Name" />

                <TableColumn fx:id="barcodeColumn"
                             prefWidth="115.0"
                             text="Barcode" />

                <TableColumn fx:id="categoryColumn"
                             prefWidth="85.0"
                             text="Category" />

                <TableColumn fx:id="priceColumn"
                             prefWidth="70.0"
                             text="Price" />

                <TableColumn fx:id="sellPriceColumn"
                             prefWidth="75.0"
                             text="Sell Price" />

                <TableColumn fx:id="createdByColumn"
                             prefWidth="90.0"
                             text="Created By" />

                <TableColumn fx:id="actionColumn"
                             prefWidth="117.0"
                             text="Actions" />

            </columns>

        </TableView>

    </children>

</AnchorPane>
