<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="800.0"
      spacing="10.0"
      style="-fx-background-color: #f4f6f9;"
      xmlns="http://javafx.com/javafx/11.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mls.learningfx.controller.ProductViewController">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
    </padding>

    <children>

        <!-- header: back, title, action buttons -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">

            <children>

                <Button fx:id="backButton"
                        text="BACK"
                        mnemonicParsing="false"
                        prefHeight="32.0"
                        prefWidth="80.0" />

                <Label text="Products"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="addProductButton"
                        text="ADD PRODUCT"
                        mnemonicParsing="false"
                        prefHeight="32.0"
                        prefWidth="130.0" />

                <Button fx:id="updateStockButton"
                        text="UPDATE STOCK"
                        mnemonicParsing="false"
                        prefHeight="32.0"
                        prefWidth="130.0" />

            </children>
        </HBox>

        <!-- search row -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">

            <children>

                <TextField fx:id="searchField"
                           promptText="Search products..."
                           prefHeight="32.0"
                           HBox.hgrow="ALWAYS" />

                <TextField fx:id="barcodeField"
                           promptText="Enter or scan barcode..."
                           prefHeight="32.0"
                           prefWidth="250.0" />

            </children>
        </HBox>

        <!-- product table -->
        <TableView fx:id="productTable" VBox.vgrow="ALWAYS">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

            <columns>

                <TableColumn fx:id="idColumn"
                             prefWidth="40.0"
                             text="ID" />

                <TableColumn fx:id="nameColumn"
                             prefWidth="130.0"
                             text="Name" />

                <TableColumn fx:id="barcodeColumn"
                             prefWidth="110.0"
                             text="Barcode" />

                <TableColumn fx:id="categoryColumn"
                             prefWidth="95.0"
                             text="Category" />

                <TableColumn fx:id="priceColumn"
                             prefWidth="70.0"
                             text="Price" />

                <TableColumn fx:id="sellPriceColumn"
                             prefWidth="75.0"
                             text="Sell Price" />

                <TableColumn fx:id="stockColumn"
                             prefWidth="55.0"
                             text="Stock" />

                <TableColumn fx:id="createdByColumn"
                             prefWidth="95.0"
                             text="Created By" />

                <TableColumn fx:id="actionColumn"
                             minWidth="120.0"
                             prefWidth="120.0"
                             text="Actions" />

            </columns>

        </TableView>

    </children>

</VBox>