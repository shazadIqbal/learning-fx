<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mls.learningfx.controller.SupplierController">
   <children>
      <HBox alignment="CENTER" layoutX="8.0" layoutY="6.0" prefHeight="59.0" prefWidth="586.0">
         <children>
            <Label text="SUPPLIER">
               <font>
                  <Font size="36.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox layoutX="8.0" layoutY="65.0" prefHeight="75.0" prefWidth="586.0">
         <children>
            <Button minWidth="-Infinity" onAction="#goBack" prefHeight="26.0" prefWidth="108.0" text="Back">
               <HBox.margin>
                  <Insets left="10.0" top="20.0" />
               </HBox.margin>
            </Button>
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#addSupplier" text="ADD SUPPLIER">
               <HBox.margin>
                  <Insets left="20.0" top="20.0" />
               </HBox.margin>
            </Button>
            <Button mnemonicParsing="false">
               <HBox.margin>
                  <Insets left="300.0" top="20.0" />
               </HBox.margin>
               <graphic>
                  <ImageView fitHeight="18.0" fitWidth="20.0">
                     <image>
                        <Image url="@icon/filter.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
      </HBox>
      <TableView fx:id="supplierTable" layoutX="9.0" layoutY="140.0" prefHeight="249.0" prefWidth="586.0">
          <columns>
              <TableColumn fx:id="idColumn" text="ID" />
              <TableColumn fx:id="nameColumn" text="Name" />
              <TableColumn fx:id="contactColumn" text="Contact" />
              <TableColumn fx:id="typeColumn" prefWidth="97.0" text="Supplier Type" />
              <TableColumn fx:id="companyNameColumn" prefWidth="120.0" text="Company Name" />
            <TableColumn fx:id="actionColumn" prefWidth="128.0" text="ACTION" />
          </columns>
      </TableView>
      <Label fx:id="statusLabel" layoutX="10.0" layoutY="10.0" text=" " textFill="#64748b">
         <padding>
            <Insets bottom="18.0" left="28.0" right="28.0" top="4.0" />
         </padding>
      </Label>
   </children>
</AnchorPane>
