<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="950.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mls.learningfx.controller.SaleRecordController">

    <!-- TOP SECTION -->
    <top>
        <VBox spacing="15">
            <padding>
                <Insets bottom="15" left="25" right="25" top="20" />
            </padding>

            <!-- Back Button (Top Left) -->
            <Button fx:id="backButton" onAction="#handleBack" prefHeight="36" prefWidth="140" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Back to Sale" />

            <Label style="-fx-font-size: 25px; -fx-font-weight: bold;" text="View Sale Record" />

            <!-- Search by Sale ID -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="saleIdField" prefHeight="42" promptText="Enter Sale ID (e.g. 1, 2, 3)..." style="-fx-background-radius: 6;" HBox.hgrow="ALWAYS" />

                <Button onAction="#handleSearchSale" prefHeight="42" prefWidth="120" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Search Sale" />
            </HBox>

            <Separator />

            <!-- CUSTOMER & SALE SUMMARY CARDS -->
            <HBox spacing="20">

                <!-- Customer Info Card -->
                <VBox spacing="8" style="-fx-background-color: #eaf2ff; -fx-padding: 16; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="CUSTOMER INFORMATION" />

                    <Label fx:id="customerNameLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="-" />

                    <HBox spacing="20">
                        <Label fx:id="customerIdLabel" style="-fx-font-size: 13px;" text="Customer ID: -" />
                        <Label fx:id="customerContactLabel" style="-fx-font-size: 13px;" text="Contact: -" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="25">
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label style="-fx-font-weight: bold;" text="Total Purchases:" />
                            <Label fx:id="customerTotalPurchasesLabel" text="0" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label style="-fx-font-weight: bold;" text="Lifetime Spending:" />
                            <Label fx:id="customerLifetimeSpendingLabel" style="-fx-text-fill: #16a34a; -fx-font-weight: bold;" text="Rs. 0.00" />
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="viewAllSalesButton" disable="true" onAction="#handleViewAllCustomerSales" prefHeight="32" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="View All Sale IDs of Customer" />
                    </HBox>
                </VBox>

                <!-- Sale / Invoice Details Card -->
                <VBox spacing="8" style="-fx-background-color: #e8f7ee; -fx-padding: 16; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="SALE DETAILS" />

                    <HBox spacing="25">
                        <HBox spacing="5">
                            <Label style="-fx-font-weight: bold;" text="Sale ID:" />
                            <Label fx:id="saleIdLabel" style="-fx-font-weight: bold;" text="-" />
                        </HBox>
                        <HBox spacing="5">
                            <Label style="-fx-font-weight: bold;" text="Date:" />
                            <Label fx:id="saleDateLabel" text="-" />
                        </HBox>
                    </HBox>

                    <HBox spacing="25">
                        <HBox spacing="5">
                            <Label style="-fx-font-weight: bold;" text="Payment Method:" />
                            <Label fx:id="paymentModeLabel" text="-" />
                        </HBox>
                        <HBox spacing="5">
                            <Label style="-fx-font-weight: bold;" text="Sold By:" />
                            <Label fx:id="soldByLabel" text="-" />
                        </HBox>
                    </HBox>

                    <HBox spacing="5">
                        <Label style="-fx-font-weight: bold;" text="Purchased Summary:" />
                        <Label fx:id="totalItemsQtyLabel" text="0" />
                    </HBox>
                </VBox>

            </HBox>
        </VBox>
    </top>

    <!-- CENTER SECTION: PURCHASED PRODUCTS TABLE -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets bottom="15" left="25" right="25" top="5" />
            </padding>

            <Label style="-fx-font-size: 17px; -fx-font-weight: bold;" text="Purchased Products in This Sale" />

            <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="productIdColumn" prefWidth="90" text="Product ID" />
                    <TableColumn fx:id="productNameColumn" prefWidth="280" text="Product Name" />
                    <TableColumn fx:id="quantityColumn" prefWidth="120" text="Qty Bought" />
                    <TableColumn fx:id="priceColumn" prefWidth="160" text="Unit Price (Rs.)" />
                    <TableColumn fx:id="subTotalColumn" prefWidth="180" text="Subtotal (Rs.)" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- BOTTOM SECTION: SALE GRAND TOTAL -->
    <bottom>
        <VBox spacing="12">
            <padding>
                <Insets bottom="20" left="25" right="25" top="10" />
            </padding>

            <Separator />

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="SALE GRAND TOTAL" />
                <Label fx:id="grandTotalLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="Rs. 0.00" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>

